<?xml version="1.0"?>
<configuration>

    <property>
        <name>dfs.replication</name>
        <value>1</value>
    </property>

    <!--
        Disable HDFS permission checks for development / capstone use.
        This allows the Hive process (running as user 'hive') to write to
        HDFS directories created by the hadoop user without chown/chmod steps.
    -->
    <property>
        <name>dfs.permissions.enabled</name>
        <value>false</value>
    </property>

</configuration>
